generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // ADMIN, ORGANIZER, USER
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Fencing Models
model Fencer {
  id          String   @id // Format: C##-####
  firstName   String
  lastName    String
  gender      String   // "M" or "F"
  club        String?
  tier        String   @default("Bronze") // Diamond, Platinum, Gold, Silver, Bronze
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  results     Result[]
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  events      Event[]
}

model Event {
  id           String     @id @default(cuid())
  tournamentId String
  weapon       String     // Epee, Foil, Sabre
  category     String     // Cadet, Senior, Junior, etc.
  gender       String     // M, F, Mixed
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  results      Result[]
}

model Result {
  id         String   @id @default(cuid())
  eventId    String
  fencerId   String
  placement  Int
  pointsEarned Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fencer     Fencer   @relation(fields: [fencerId], references: [id], onDelete: Cascade)
}